# ==============================================================================
# BUILDCOST CONNECT — ENVIRONMENT VARIABLES SPECIFICATION
# TARGET DEPLOYMENT: GitHub -> Render -> Supabase
# ==============================================================================
# WARNING: NEVER commit real production secrets, API keys, or .env.local to GitHub.
# This template contains variable names only.
# ==============================================================================

# ==============================================================================
# SECTION A: LOCAL DEVELOPMENT VARIABLES (.env.local)
# Place these in your local .env.local file for local development on http://localhost:3000
# ==============================================================================

# Supabase Credentials (Supports both NEXT_PUBLIC_ and VITE_ prefixes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="BuildCost Connect - Property Calculator 2.0"

# Local Contact & Support
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Local Payment Configuration (Defaults)
NEXT_PUBLIC_EASYPAISA_ACCOUNT_NAME=
NEXT_PUBLIC_EASYPAISA_NUMBER=
NEXT_PUBLIC_JAZZCASH_ACCOUNT_NAME=
NEXT_PUBLIC_JAZZCASH_NUMBER=

# Local Admin Permissions (comma-separated admin emails)
SUPER_ADMIN_EMAILS=
ADMIN_JWT_SECRET=

# ==============================================================================
# SECTION B: RENDER PRODUCTION VARIABLES (Render Dashboard > Environment)
# Configure these in your Render Web Service dashboard under "Environment"
# ==============================================================================

# 1. Render Runtime Configuration
NODE_VERSION=20.18.0
HOSTNAME=0.0.0.0

# 2. Production Supabase Integration (Live Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side Only Service Role Key (NEVER prefix with NEXT_PUBLIC_ or VITE_)
SUPABASE_SERVICE_ROLE_KEY=

# 3. Production App Identity & URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME="BuildCost Connect - Property Calculator 2.0"

# 4. Support & Business Contacts
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# 5. Pakistan Manual Payment Gateway Details
NEXT_PUBLIC_EASYPAISA_ACCOUNT_NAME=
NEXT_PUBLIC_EASYPAISA_NUMBER=
NEXT_PUBLIC_JAZZCASH_ACCOUNT_NAME=
NEXT_PUBLIC_JAZZCASH_NUMBER=

# 6. Production Security & Super Admin Control
SUPER_ADMIN_EMAILS=
ADMIN_JWT_SECRET=
