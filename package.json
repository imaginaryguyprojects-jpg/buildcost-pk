{
  "name": "buildcost-connect",
  "version": "1.2.0",
  "private": true,
  "description": "BuildCost Connect - Pakistan Construction Cost Intelligence Platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "build:mobile-bundle": "node scripts/build-mobile-bundle.mjs",
    "build:apk": "node scripts/build-standalone-apk.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
