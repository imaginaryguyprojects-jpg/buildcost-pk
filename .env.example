# Supabase Public Configuration (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Server-side privileged only - NEVER expose to browser)
# CRITICAL SECURITY RULE: Do NOT expose with NEXT_PUBLIC_
