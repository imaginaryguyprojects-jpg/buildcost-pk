NEXT_PUBLIC_DEFAULT_CITY="Islamabad"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_DEFAULT_MARLA_SQFT=225
NEXT_PUBLIC_SITE_MODE="production"

