# ==============================================================================
# BuildCost Connect - Environment Configuration
# Pakistan Construction Cost Intelligence Platform
# ==============================================================================

# Supabase Public Configuration (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Server-side privileged only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME="BuildCost Connect"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY="Islamabad"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_DEFAULT_MARLA_SQFT=225
NEXT_PUBLIC_SITE_MODE="production"
